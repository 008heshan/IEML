{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "IEML",
    "version":  "0.1.0-beta.52",
    "identifier":  "com.ieml.launcher",
    "build":  {
                  "beforeDevCommand":  "pnpm exec vite --port 1420 --strictPort",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "pnpm exec vite build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "IEML",
                                    "width":  1180,
                                    "height":  760,
                                    "minWidth":  1040,
                                    "minHeight":  640,
                                    "resizable":  true,
                                    "center":  true,
                                    "decorations":  false,
                                    "transparent":  false,
                                    "dragDropEnabled":  true,
                                    "shadow":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; img-src \u0027self\u0027 asset: http://asset.localhost data: https:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "languages":  [
                                                                  "SimpChinese",
                                                                  "English"
                                                              ]
                                            }
                               },
                   "resources":  [

                                 ],
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "endpoints":  [
                                                      "https://cnb.cool/IEML_Official/IEML-releases/-/releases/download/latest/latest.json"
                                                  ],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyMTY3NjUzRDBBQzY2OEIKUldTTFpxelFVM1lXTWk3SjZDbEFSZ3VyWUhUSCtjeDZ0dGE5RDZpeVAzbmxIS2YyUkdJb3dDM3UK"
                                }
                }
}