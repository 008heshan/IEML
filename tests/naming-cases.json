{
  "_why": [
    "目录名规范的**跨语言**用例表（ADR-055 决定八）。",
    "",
    "Rust 侧 `domain::naming` 与前端 `src/domain/naming.ts` 是**同一个规则的两份实现**",
    "（前端在浏览器 demo 模式下没有 Rust 可用，所以镜像一份）。",
    "两边各跑一遍这张表，算出来必须逐字一致 —— 界面上显示的版本名与磁盘上的目录名",
    "不一致过一次（真机：账本 `vanilla-262` vs 磁盘 `26.3-fabric-0.19.5`），",
    "代价是启动器再也找不到那个版本，所以这条一致性必须被测试钉住。",
    "",
    "`dir`: 规范目录名；`display`: 界面上的版本名；`sanitize`: 清洗后的目录名；",
    "`unique`: [候选名, 已占用名…] → 去重后的名字。"
  ],
  "dir": [
    { "mc": "26.3", "loader": null, "loaderVersion": null, "addons": [], "want": "26.3" },
    { "mc": "1.12.2", "loader": null, "loaderVersion": null, "addons": [], "want": "1.12.2" },
    {
      "mc": "1.20.1",
      "loader": "forge",
      "loaderVersion": "47.2.0",
      "addons": [],
      "want": "1.20.1-forge-47.2.0"
    },
    {
      "mc": "26.3",
      "loader": "fabric",
      "loaderVersion": "0.19.5",
      "addons": [],
      "want": "26.3-fabric-0.19.5"
    },
    {
      "mc": "1.21.1",
      "loader": "neoforge",
      "loaderVersion": "21.1.72",
      "addons": [],
      "want": "1.21.1-neoforge-21.1.72"
    },
    {
      "mc": "1.20.1",
      "loader": "quilt",
      "loaderVersion": "0.27.0",
      "addons": [],
      "want": "1.20.1-quilt-0.27.0"
    },
    {
      "mc": "26.3",
      "loader": "fabric",
      "loaderVersion": "",
      "addons": [],
      "want": "26.3-fabric"
    },
    {
      "mc": "26.3",
      "loader": "fabric",
      "loaderVersion": "   ",
      "addons": [],
      "want": "26.3-fabric"
    },
    {
      "mc": "1.12.2",
      "loader": "forge",
      "loaderVersion": "14.23.5.2860",
      "addons": [{ "kind": "optifine", "version": "HD_U_E7" }],
      "want": "1.12.2-forge-14.23.5.2860-optifine-HD_U_E7"
    },
    {
      "mc": "1.12.2",
      "loader": null,
      "loaderVersion": null,
      "addons": [{ "kind": "optifine", "version": "HD_U_E7" }],
      "want": "1.12.2-optifine-HD_U_E7"
    },
    {
      "mc": "1.7.10",
      "loader": "forge",
      "loaderVersion": "10.13.4.1614",
      "addons": [{ "kind": "liteloader", "version": "1.7.10_04" }],
      "want": "1.7.10-forge-10.13.4.1614-liteloader-1.7.10_04"
    },
    { "mc": "", "loader": null, "loaderVersion": null, "addons": [], "want": null },
    {
      "mc": "    ",
      "loader": null,
      "loaderVersion": null,
      "addons": [],
      "want": null
    }
  ],
  "display": [
    { "mc": "1.12.2", "loader": null, "loaderVersion": null, "want": "Minecraft 1.12.2" },
    {
      "mc": "26.2",
      "loader": "fabric",
      "loaderVersion": "0.19.5",
      "want": "Minecraft 26.2 + Fabric 0.19.5"
    },
    {
      "mc": "26.2",
      "loader": "fabric",
      "loaderVersion": "",
      "want": "Minecraft 26.2 + Fabric"
    },
    {
      "mc": "1.20.1",
      "loader": "forge",
      "loaderVersion": "47.2.0",
      "want": "Minecraft 1.20.1 + Forge 47.2.0"
    },
    {
      "mc": "1.21.1",
      "loader": "neoforge",
      "loaderVersion": "21.1.72",
      "want": "Minecraft 1.21.1 + NeoForge 21.1.72"
    },
    {
      "mc": "1.20.1",
      "loader": "quilt",
      "loaderVersion": "0.27.0",
      "want": "Minecraft 1.20.1 + Quilt 0.27.0"
    }
  ],
  "sanitize": [
    { "raw": "1.20.1", "want": "1.20.1" },
    { "raw": "a/b", "want": "a-b" },
    { "raw": "a:b*c", "want": "a-b-c" },
    { "raw": "a<>b", "want": "a-b" },
    { "raw": "1.20.1.", "want": "1.20.1" },
    { "raw": "  x  ", "want": "x" },
    { "raw": "a--b", "want": "a-b" },
    { "raw": "", "want": null },
    { "raw": "   ", "want": null },
    { "raw": "...", "want": null },
    { "raw": "///", "want": null },
    { "raw": "CON", "want": "CON-ver" },
    { "raw": "nul", "want": "nul-ver" }
  ],
  "unique": [
    { "base": "26.3-fabric-0.19.5", "taken": [], "want": "26.3-fabric-0.19.5" },
    { "base": "26.3-fabric-0.19.5", "taken": ["26.3-fabric-0.19.5"], "want": "26.3-fabric-0.19.5-2" },
    {
      "base": "26.3-fabric-0.19.5",
      "taken": ["26.3-fabric-0.19.5", "26.3-fabric-0.19.5-2"],
      "want": "26.3-fabric-0.19.5-3"
    },
    { "base": "26.3", "taken": ["1.20.1"], "want": "26.3" },
    { "base": "Fabric-1", "taken": ["fabric-1"], "want": "Fabric-1-2" },
    { "base": "fabric-1", "taken": ["FABRIC-1"], "want": "fabric-1-2" }
  ],
  "parse": [
    {
      "dir": "1.20.1-forge-47.2.0",
      "want": { "mc": "1.20.1", "loader": "forge", "loaderVersion": "47.2.0" }
    },
    {
      "dir": "26.3-fabric-0.19.5",
      "want": { "mc": "26.3", "loader": "fabric", "loaderVersion": "0.19.5" }
    },
    {
      "dir": "1.21.1-neoforge-21.1.72",
      "want": { "mc": "1.21.1", "loader": "neoforge", "loaderVersion": "21.1.72" }
    },
    { "dir": "26.3", "want": { "mc": "26.3", "loader": null, "loaderVersion": null } },
    {
      "dir": "fabric-loader-0.19.5-26.3",
      "want": { "mc": "26.3", "loader": "fabric", "loaderVersion": "0.19.5" },
      "_note": "PCL 那种写法：MC 版本在末尾。★ 加载器那一段不能丢 —— 丢了两个加载器的版本会撞名"
    },
    {
      "dir": "quilt-loader-0.27.0-1.20.1",
      "want": { "mc": "1.20.1", "loader": "quilt", "loaderVersion": "0.27.0" }
    },
    {
      "dir": "forge-47.2.0-1.20.1",
      "want": { "mc": "1.20.1", "loader": "forge", "loaderVersion": "47.2.0" }
    },
    {
      "dir": "fabric-loader-0.19.5",
      "want": null,
      "_note": "只有加载器版本、没有 MC 版本 → 认不出来（保留原名，不许猜）"
    },
    {
      "dir": "forge-nightly-latest",
      "want": null,
      "_note": "最后一段不像版本号 → 不认"
    },
    { "dir": "vanilla-262", "want": { "mc": "vanilla-262", "loader": null, "loaderVersion": null } }
  ]
}
